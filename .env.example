# Copy to .env.local and fill in.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used by the event-ingestion job to bypass RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claude (recommendations + Break Buddy chat). Without it, ranking falls back to the heuristic.
ANTHROPIC_API_KEY=

# Optional: real-time external events (https://developer.ticketmaster.com)
TICKETMASTER_API_KEY=
# Shared secret for GET /api/events/ingest (sent as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Optional: comma-separated emails allowed to view /metrics. Empty = any signed-in user.
METRICS_ADMIN_EMAILS=
